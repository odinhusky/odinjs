{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "types": ["vite/client", "vitest"],
    "paths": {
      "@libs/*": ["libs/src/*"],
      "@commonUtils/*": ["libs/src/commonUtils/*"],
      "@mode2/*": ["libs/src/mode2/*"],
      "@mode2API/*": ["libs/src/mode2/external/api/*"],
      "@mode2Trans/*": ["libs/src/mode2/external/transform/*"],
      "@constant/*": ["libs/src/constant/*"],
      "@langs/*": ["apps/india-game/plugins/i18next/langs/*"],
      "@plugins/*": ["apps/india-game/plugins/*"],
      "@stylesV/*": ["apps/india-game/src/styles/*"],
      "@modals/*": ["apps/india-game/src/ui/2/modals/*"],
      "@pages/*": ["apps/india-game/src/ui/2/pages/*"],
      "@components/*": ["apps/india-game/src/ui/2/components/*"],
      "@router/*": ["apps/india-game/src/router/2/*"],
      "@templates/*": ["apps/india-game/src/ui/2/templates/*"],
      "@apps/*": ["apps/india-game/src/ui/2/apps/*"],

      "@/*": ["apps/india-game/src/*"],
      "@transform/*": ["apps/india-game/src/external/transform/*"]
    }
  },
  "files": [],
  "include": [],

  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
