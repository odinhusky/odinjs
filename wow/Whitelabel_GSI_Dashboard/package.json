{
  "name": "wow-core",
  "version": "0.0.1",
  "description": "Backoffice Project",
  "productName": "Gamingsoft International",
  "author": "Blues <blueschen@jetfuel.com.tw>",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "dev:mock": "cross-env MOCK_MODE=true quasar dev",
    "lint:eslint": "eslint src/**/*.{ts,js,vue} --max-warnings=0",
    "ts-check": "vue-tsc --noEmit --skipLibCheck > ts-check-error.txt",
    "build:testing": "quasar build",
    "build:prod": "cross-env NODE_ENV=production quasar build",
    "postinstall": "quasar prepare",
    "prepare": "husky install"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@quasar/extras": "^1.16.4",
    "@quasar/quasar-ui-qcalendar": "^4.0.0-beta.16",
    "@tanstack/vue-query": "^5.95.0",
    "@tinymce/tinymce-vue": "^4.0.7",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.2.1",
    "cross-env": "^7.0.3",
    "date-fns": "^3.3.1",
    "decimal.js": "^10.4.3",
    "echarts": "^5.4.3",
    "element-plus": "^2.11.8",
    "googleapis": "^129.0.0",
    "interactjs": "^1.10.27",
    "is-url-http": "^2.3.8",
    "luxon": "^3.7.2",
    "papaparse": "^5.4.1",
    "pinia": "^2.0.11",
    "pinia-plugin-persistedstate": "^3.2.1",
    "quasar": "^2.6.0",
    "ramda": "0.28.0",
    "tinymce-i18n": "^24.1.15",
    "vue": "^3.0.0",
    "vue-datepicker-next": "^1.0.3",
    "vue-draggable-next": "^2.2.1",
    "vue-easy-lightbox": "^1.17.0",
    "vue-echarts": "^6.6.1",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^2.6.0",
    "@types/echarts": "^4.9.22",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/ramda": "0.28.12",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.3.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-quasar": "^1.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "glob": "^13.0.1",
    "globals": "^17.5.0",
    "husky": "^8.0.0",
    "lint-staged": "13.0.3",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.6.2",
    "progress": "^2.0.3",
    "quasar-app-extension-qnumber": "^2.1.3",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": "^22",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "pnpm": {
    "overrides": {
      "@jridgewell/trace-mapping": "^0.3.31"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "node scripts/eslint-fix.js"
    ]
  }
}
