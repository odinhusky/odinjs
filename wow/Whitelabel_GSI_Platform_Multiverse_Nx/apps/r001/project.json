{
  "name": "r001",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/r001/src",
  "targets": {
    "serve": {
      "command": "nuxi dev",
      "options": {
        "cwd": "apps/r001"
      }
    },
    "build": {
      "command": "nuxi generate",
      "options": {
        "cwd": "apps/r001"
      },
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/**/*.spec.ts",
        "{workspaceRoot}/libs/shared/ui-layer/**/*",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "preview": {
      "command": "nuxi preview",
      "options": {
        "cwd": "apps/r001"
      }
    }
  }
}
