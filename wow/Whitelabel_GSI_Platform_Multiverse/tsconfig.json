{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "isolatedModules": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@router/build": ["./src/router/build*", "./build*"],
      "app/*": ["./*"],
      "src/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./src/**/*.vue",
    "./src/**/*.d.ts",
    "./template/**/*.ts",
    "./template/**/*.vue",
    "./quasar.config.js",
    "./shims-vue.d.ts"
  ],
  "exclude": [
    "dist",
    ".quasar",
    "coverage",
    "public",
    "tests",
    "cypress",
    "**/*.spec.ts",
    "**/__mocks__/**",
    ".vscode",
    "tool",
    "src-cordova"
  ]
}
